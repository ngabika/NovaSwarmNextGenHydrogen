# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional multi-provider keys managed on the server (comma-separated for pools)
OPENAI_API_KEYS=""
ANTHROPIC_API_KEYS=""
OPENROUTER_API_KEYS=""
GEMINI_API_KEYS=""

# Optional Telegram Bot Token & Authorized Chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional Google OAuth2 credentials for Gmail/Calendar/Drive/Photos MCP
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional GitHub token for authenticated OTA release checks
GITHUB_TOKEN=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000
