# GEMINI_API_KEY: Optional Gemini API key (or configure keys encrypted via Web UI)
GEMINI_API_KEY=""

# Optional multi-provider keys managed on the server (comma-separated for pools)
OPENAI_API_KEYS=""
ANTHROPIC_API_KEYS=""
OPENROUTER_API_KEYS=""
GEMINI_API_KEYS=""

# Optional Telegram Bot Token & Authorized Chat ID
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional Google OAuth2 credentials for Gmail/Calendar/Drive/Photos MCP
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional GitHub token for authenticated OTA release checks
GITHUB_TOKEN=""

# OTA GPG signature policy: auto (verify whenever signed tags exist), 1 (strict fail-closed), 0 (disabled)
NOVASWARM_VERIFY_TAG_SIG="auto"

# Optional extra allowed Host headers for DNS-rebinding protection (comma-separated)
NOVASWARM_ALLOWED_HOSTS=""

# APP_URL: The local LAN base URL where NovaSwarm is accessed
APP_URL="http://localhost:3000"
PORT=3000
