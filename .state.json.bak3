  "incidentPlaybooks": [
    {
      "id": "pb-oom",
      "slug": "linux-oom",
      "title": "Magas RAM / OOM Killer Elhárítás",
      "severity": "critical",
      "symptoms": [
        "Szolgáltatás hirtelen újraindul",
        "dmesg Killed process",
        "Swap 95%+"
      ],
      "steps": [
        {
          "id": "s1",
          "commandOrCheck": "free -m && ps aux --sort=-%mem | head -n 10",
          "done": false
        },
        {
          "id": "s2",
          "commandOrCheck": "dmesg -T | grep -i -E \"oom|killed\" | tail -n 15",
          "done": false
        },
        {
          "id": "s3",
          "commandOrCheck": "Ollama modell ürítés / Node heap limit ellenőrzése",
          "done": false
        }
      ]
    },
    {
      "id": "pb-nginx-502",
      "slug": "reverse-proxy-502",
      "title": "Reverse Proxy 502 Bad Gateway",
      "severity": "high",
      "symptoms": [
        "502 válasz böngészőben",
        "Upstream kapcsolat elutasítva"
      ],
      "steps": [
        {
          "id": "s1",
          "commandOrCheck": "ss -tulpn | grep :3000",
          "done": false
        },
        {
          "id": "s2",
          "commandOrCheck": "systemctl status novaswarm --no-pager",
          "done": false
        },
        {
          "id": "s3",
          "commandOrCheck": "nginx -t && journalctl -u nginx -n 40",
          "done": false
        }
      ]
    },
    {
      "id": "pb-docker-crash",
      "slug": "docker-crashloop",
      "title": "Docker Konténer CrashLoopBackOff",
      "severity": "high",
      "symptoms": [
        "Restarting státusz",
        "Kilépési kód 1 vagy 137"
      ],
      "steps": [
        {
          "id": "s1",
          "commandOrCheck": "docker ps -a --format \"table {{.Names}}\\t{{.Status}}\"",
          "done": false
        },
        {
          "id": "s2",
          "commandOrCheck": "docker logs --tail 80 <kontener>",
          "done": false
        },
        {
          "id": "s3",
          "commandOrCheck": "docker system df (lemezhely ellenőrzés)",
          "done": false
        }
      ]
    },
    {
      "id": "pb-sqlite-lock",
      "slug": "sqlite-locked",
      "title": "SQLite Database Locked / WAL Recovery",
      "severity": "medium",
      "symptoms": [
        "SQLITE_BUSY",
        "Lassú írási művelet"
      ],
      "steps": [
        {
          "id": "s1",
          "commandOrCheck": "PRAGMA wal_checkpoint(TRUNCATE); PRAGMA quick_check;",
          "done": false
        },
        {
          "id": "s2",
          "commandOrCheck": "lsof | grep .sqlite (zároló folyamatok listázása)",
          "done": false
        }
      ]
    },
    {
      "id": "pb-ssl-exp",
      "slug": "ssl-expiry",
      "title": "TLS / SSL Tanúsítvány Lejárat",
      "severity": "high",
      "symptoms": [
        "ERR_CERT_DATE_INVALID",
        "< 7 nap hátra"
      ],
      "steps": [
        {
          "id": "s1",
          "commandOrCheck": "certbot certificates || openssl s_client -connect host:443",
          "done": false
        },
        {
          "id": "s2",
          "commandOrCheck": "certbot renew --dry-run && systemctl reload nginx",
          "done": false
        }
      ]
    },
    {
      "id": "pb-io-wait",
      "slug": "sd-iowait",
      "title": "Magas Lemez I/O Wait / SD Lassulás",
      "severity": "medium",
      "symptoms": [
        "Load average magas alacsony CPU mellett",
        "wa% > 25%"
      ],
      "steps": [
        {
          "id": "s1",
          "commandOrCheck": "vmstat 1 5 && df -h && df -i",
          "done": false
        },
        {
          "id": "s2",
          "commandOrCheck": "SD-kártya Kímélő Mód engedélyezése + WAL flush",
          "done": false
        }
      ]
    }
  ],
